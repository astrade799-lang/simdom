generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  KABID
}

enum WebStatus {
  AKTIF
  TIDAK_AKTIF
  SUSPEND
}

enum ActivityStatus {
  PENDING
  CONFIRMED
  INSTRUCTED
}

enum AuditGrade {
  BAIK      // 🟢
  SEDANG    // 🟡
  BURUK     // 🔴
  BELUM_CEK // ⚪
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String
  namaLengkap String?
  nip         String?
  password    String
  role        Role             @default(ADMIN)
  skpdId      String?
  skpd        Skpd?            @relation(fields: [skpdId], references: [id])
  reports     ActivityReport[] @relation("CreatedReports")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([email])
  @@index([skpdId])
}

model Skpd {
  id              String   @id @default(cuid())
  nama            String
  singkatan       String   @unique
  penanggungjawab String
  kontak          String
  users           User[]
  webApps         WebApp[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebApp {
  id             String           @id @default(cuid())
  nama           String
  url            String           @unique
  status         WebStatus        @default(AKTIF)
  alasanSuspend  String?
  keterangan     String?
  adminTeknis    String
  kontakAdmin    String
  vendor         String?
  kontakVendor   String?
  platform       String?
  tanggalAktif   DateTime?
  tanggalExpired DateTime?
  skpdId         String
  skpd           Skpd             @relation(fields: [skpdId], references: [id])
  activities     ActivityReport[]
  histories      DomainHistory[]
  checks         DomainCheck[]
  audits         TechnicalAudit[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([skpdId])
  @@index([status])
}

model ActivityReport {
  id            String         @id @default(cuid())
  jenisKegiatan String
  deskripsi     String
  tanggal       DateTime
  status        ActivityStatus @default(PENDING)
  instruksi     String?
  webAppId      String
  webApp        WebApp         @relation(fields: [webAppId], references: [id])
  createdById   String
  createdBy     User           @relation("CreatedReports", fields: [createdById], references: [id])
  confirmedById String?
  buktiUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([webAppId])
  @@index([status])
  @@index([tanggal])
}

model DomainHistory {
  id        String   @id @default(cuid())
  webAppId  String
  webApp    WebApp   @relation(fields: [webAppId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  action    String
  fieldName String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([webAppId])
  @@index([createdAt])
}

model DomainCheck {
  id           String   @id @default(cuid())
  webAppId     String
  webApp       WebApp   @relation(fields: [webAppId], references: [id], onDelete: Cascade)
  isOnline     Boolean
  responseTime Int?
  statusCode   Int?
  checkedAt    DateTime @default(now())

  @@index([webAppId])
  @@index([checkedAt])
}

model TechnicalAudit {
  id            String @id @default(cuid())
  webAppId      String
  webApp        WebApp @relation(fields: [webAppId], references: [id], onDelete: Cascade)
  checkedById   String
  checkedByName String

  performanceGrade AuditGrade @default(BELUM_CEK)
  performanceScore Int?
  performanceLink  String?

  securityGrade AuditGrade @default(BELUM_CEK)
  securityScore String?
  securityLink  String?

  dnsGrade  AuditGrade @default(BELUM_CEK)
  dnsStatus String?
  dnsLink   String?

  teknologi   String?
  catatanUmum String?

  checkedAt DateTime @default(now())

  @@index([webAppId])
  @@index([checkedAt])
}